<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_logo">
    <!-- Scale up and fade in the background circle -->
    <target android:name="backgroundCircle">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="600"
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:duration="600"
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:duration="400"
                    android:propertyName="alpha"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <!-- Animate left music note bar -->
    <target android:name="noteLeft">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="400"
                    android:startOffset="300"
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <!-- Animate right music note bar -->
    <target android:name="noteRight">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="400"
                    android:startOffset="400"
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <!-- Animate left curve -->
    <target android:name="noteCurveLeft">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="300"
                    android:startOffset="500"
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <!-- Animate right curve -->
    <target android:name="noteCurveRight">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="300"
                    android:startOffset="600"
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <!-- Fade in text -->
    <target android:name="textPath">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="500"
                android:startOffset="700"
                android:propertyName="alpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <!-- Pulse animation for background -->
    <target android:name="backgroundCircle">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="1000"
                    android:startOffset="1200"
                    android:propertyName="scaleX"
                    android:valueFrom="1"
                    android:valueTo="1.05"
                    android:valueType="floatType"
                    android:repeatCount="2"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/linear" />
                <objectAnimator
                    android:duration="1000"
                    android:startOffset="1200"
                    android:propertyName="scaleY"
                    android:valueFrom="1"
                    android:valueTo="1.05"
                    android:valueType="floatType"
                    android:repeatCount="2"
                    android:repeatMode="reverse"
                    android:interpolator="@android:interpolator/linear" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>